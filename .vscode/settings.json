{
  // LaTeX Workshop with tectonic (~/.local/bin/tectonic; no TeX Live on the server).
  // "fast" (default, on save): one pass reusing the previous run's .aux/.bbl, ~2 s.
  // "full": reruns until references settle and runs BibTeX, ~13 s; use after adding a \cite or \label.
  "latex-workshop.latex.tools": [
    {
      "name": "tectonic-fast",
      "command": "tectonic",
      "args": ["--only-cached", "--synctex", "--keep-intermediates", "--keep-logs", "--reruns", "0",
               "--outdir", "%OUTDIR%", "%DOC%.tex"]
    },
    {
      "name": "tectonic-full",
      "command": "tectonic",
      "args": ["--synctex", "--keep-intermediates", "--keep-logs", "--outdir", "%OUTDIR%", "%DOC%.tex"]
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "fast (1 pass)", "tools": ["tectonic-fast"] },
    { "name": "full (refs + bib)", "tools": ["tectonic-full"] }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.synctex.afterBuild.enabled": true
}
